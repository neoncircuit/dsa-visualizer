# Feedback Backend Configuration
# Uncomment and fill in the section for your chosen backend.
# Only one backend section should be active at a time.

# ── Supabase (default) ──
# Create a project at https://supabase.com, then copy values from Settings > API.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_CONNECTION_STRING=your_supabase_connection_string
VITE_SUPABASE_SERVICE_ROLE=your_supabase_service_role_key
VITE_SUPERBASE_PROJECT_PASSWORD=your_supabase_project_password

# ── Firebase (alternative) ──
# Create a project at https://console.firebase.google.com, then enable Firestore.
# VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_COLLECTION=feedback
